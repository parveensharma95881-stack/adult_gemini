name: Build APK
on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'
          cache: 'gradle'

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          # वर्ज़न बढ़ा दिया है ताकि पुराना एरर न आए
          flutter-version: '3.22.0'
          cache: true

      - name: Build APK
        run: |
          # 1. पुराना सारा कचरा साफ़ करो
          flutter clean
          
          # 2. नई डिपेंडेंसी डाउनलोड करो
          flutter pub get
          
          # 3. फाइनल बिल्ड (बिना श्रिंकिंग के ताकि R8 एरर न आए)
          flutter build apk --release --target-platform android-arm64 --no-shrink

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Balaji-App-Final-Success
          path: build/app/outputs/flutter-apk/app-release.apk
