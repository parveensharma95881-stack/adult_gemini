
import sqlite3

conn = sqlite3.connect('panchang.db')
c = conn.cursor()
c.execute('CREATE TABLE panchang (date TEXT, tithi TEXT, nakshatra TEXT, shubh_muhurat TEXT)')

# यहाँ लूप चलाकर 50 साल का डेटा भरा जाएगा (Sample)
data = [('2026-05-04', 'Ashtami', 'Magha', '11:45 AM - 12:30 PM')]
c.executemany('INSERT INTO panchang VALUES (?,?,?,?)', data)

conn.commit()
conn.close()
print("विवेक भाई, पंचांग डेटाबेस तैयार है!")
